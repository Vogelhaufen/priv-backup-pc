#!/usr/bin/env bash

set -euo pipefail

GAME_DIR="$HOME/Games/star-citizen"
CUDA_PATCH="$GAME_DIR/libcuda.patched.so"

# Novideo GPU?
echo "========== GPU Detection =========="
if ! lspci | grep -iq nvidia; then
  echo "✘ No NVIDIA graphics card found. Exiting."
  exit 1
fi
echo "✔ NVIDIA GPU detected."

# Ensure required scripts are executable
chmod +x "$GAME_DIR/mount_libcuda.sh" "$GAME_DIR/launchoptions.sh" "$GAME_DIR/patchcuda.sh"

# Run patch only if the file doesn't exist
if [[ ! -f "$CUDA_PATCH" ]]; then
    echo "Patching libcuda... ($CUDA_PATCH not found)"
    "$GAME_DIR/patchcuda.sh"
else
    echo "libcuda.patched.so already exists. Skipping patch."
fi

# Launch the game scripts
"$GAME_DIR/mount_libcuda.sh"
"$GAME_DIR/launchoptions.sh"
